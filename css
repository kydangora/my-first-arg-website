
body {
    background-color: #2F1B14;
    color: white;
    text-align: center;
    font-family: Georgia, serif;

    background-image:
        radial-gradient(circle at center,
        rgba(255, 220, 150, 0.08),
        rgba(0,0,0,0.85));
}

h1, h2, h3, h4, h5, h6,
p,
em {
    color: white;
}

.hidden {
    background: black;
    color: black;
    cursor: help;
}

.hidden:hover {
    color: white;
}
